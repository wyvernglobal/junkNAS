[Unit]
Description=JunkNAS Distributed Private Cloud Daemon
After=network-online.target 
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Setup dirs ONCE, as root
ExecStartPre=+/bin/bash -c '\
    mkdir -p /var/lib/junknas/{smb,storage,i2pd} \
             /mnt/junknas \
             /mnt/junknas-peers && \
    chown -R junknas:junknas \
             /var/lib/junknas \
             /mnt/junknas \
             /mnt/junknas-peers \
'

ExecStart=/var/lib/junknas/startup.sh

Environment=HOME=/root

# Allow writes where needed
ReadWritePaths=/var/lib/junknas /mnt/junknas /mnt/junknas-peers /var/lib/i2pd

PrivateTmp=false
DeviceAllow=/dev/fuse rw
PrivateDevices=false
ProtectSystem=false

[Install]
WantedBy=multi-user.target

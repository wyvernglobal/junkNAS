[Unit]
Description=I2pd systemd service
After=network-online.target junknas.service
Wants=network-online.target junknas.service

[Service]
Type=simple
User=root
Group=root

ExecStart=/usr/bin/sudo i2pd --datadir=/var/lib/i2pd

Restart=on-failure
RestartSec=10



[Install]
WantedBy=multi-user.target

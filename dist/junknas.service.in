[Unit]
Description=JunkNAS Distributed Private Cloud Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=junknas
Group=junknas

# Setup dirs ONCE, as root
ExecStartPre=+/bin/bash -c '\
    mkdir -p /var/lib/junknas/{smb,storage,i2pd} \
             /mnt/junknas \
             /mnt/junknas-peers && \
    chown -R junknas:junknas \
             /var/lib/junknas \
             /mnt/junknas \
             /mnt/junknas-peers \
'

ExecStart=/usr/local/bin/junknasd \
    --daemon \
    --data=/var/lib/junknas \
    --storage=/var/lib/junknas/storage \
    --smb-user=junknas

Restart=on-failure
RestartSec=10

# Environment for i2pd fallback
Environment=HOME=/var/lib/junknas

# Allow writes where needed
ReadWritePaths=/var/lib/junknas /mnt/junknas /mnt/junknas-peers

# Minimal hardening (safe)
NoNewPrivileges=true
PrivateTmp=false
# Required for FUSE
DeviceAllow=/dev/fuse rw
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN

# Allow mount syscalls
PrivateDevices=false
ProtectSystem=false
[Install]
WantedBy=multi-user.target
